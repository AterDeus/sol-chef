{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sol-chef.ru/schemas/recipe.schema.json",
  "title": "Recipe",
  "description": "Запись рецепта в data/recipes.json",
  "type": "object",
  "required": ["id", "title", "source_url", "summary", "tags"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "Уникальный идентификатор, латиница через дефис"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "source_type": {
      "type": "string",
      "enum": ["video", "article"]
    },
    "source_url": {
      "type": "string",
      "format": "uri"
    },
    "source_name": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "minItems": 2,
      "maxItems": 5,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "category": {
      "type": "string",
      "enum": [
        "птица",
        "говядина",
        "свинина",
        "крупы",
        "гарнир",
        "суп",
        "выпечка",
        "десерт",
        "соусы",
        "завтрак",
        "рыба"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "ingredients": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "steps": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "notes": {
      "type": "string"
    },
    "added": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    }
  }
}
