{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MeatGuide",
  "type": "object",
  "required": ["intro_lead", "intro", "methods"],
  "additionalProperties": false,
  "properties": {
    "intro_lead": { "type": "string", "minLength": 1 },
    "intro": { "type": "string", "minLength": 1 },
    "methods": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "sub", "cards"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "sub": { "type": "string", "minLength": 1 },
          "cards": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["title", "readout_label", "readout_value", "text", "pitfall"],
              "additionalProperties": false,
              "properties": {
                "title": { "type": "string", "minLength": 1 },
                "readout_label": { "type": "string", "minLength": 1 },
                "readout_value": { "type": "string", "minLength": 1 },
                "text": { "type": "string", "minLength": 1 },
                "pitfall": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    }
  }
}
