{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sol-chef.ru/schemas/recipe.schema.json",
  "title": "Recipe",
  "description": "Запись рецепта в data/recipes/<метод>/<продукт>.json",
  "type": "object",
  "required": ["id", "title", "summary", "tags"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "Уникальный идентификатор, латиница через дефис"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "source_type": {
      "type": "string",
      "enum": ["video", "article"]
    },
    "source_url": {
      "type": "string",
      "description": "Ссылка на видео или статью; если нет внешнего источника — поле можно опустить или оставить пустым"
    },
    "source_name": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "minItems": 2,
      "maxItems": 5,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "category": {
      "type": "string",
      "enum": [
        "птица",
        "говядина",
        "свинина",
        "баранина",
        "крупы",
        "рис",
        "гарнир",
        "паста",
        "суп",
        "выпечка",
        "десерт",
        "соусы",
        "завтрак",
        "рыба"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "ingredients": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "amount": { "type": "number" },
          "amount_max": { "type": "number" },
          "unit": { "type": "string", "minLength": 1 },
          "detail": { "type": "string" },
          "scalable": { "type": "boolean" },
          "scale_mode": {
            "type": "string",
            "enum": ["linear", "gentle", "whole"],
            "description": "linear — пропорционально; gentle — слабее (сода); whole — целые шт (яйца)"
          }
        }
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "oneOf": [
          { "type": "string", "minLength": 1 },
          {
            "type": "object",
            "required": ["text"],
            "additionalProperties": false,
            "properties": {
              "text": { "type": "string", "minLength": 1 },
              "timer_min": { "type": "number", "minimum": 0 },
              "timer_sec": { "type": "number", "minimum": 0, "maximum": 3599 },
              "timer_label": { "type": "string" },
              "timer_note": { "type": "string", "description": "Оговорка к таймеру: для какой порции, когда ориентир неточен" }
            }
          }
        ]
      }
    },
    "prep": {
      "type": "array",
      "description": "Напоминания до начала готовки (разморозка, маринад, комнатная температура)",
      "items": {
        "type": "object",
        "required": ["text"],
        "additionalProperties": false,
        "properties": {
          "text": { "type": "string", "minLength": 1 },
          "before_min": { "type": "number", "minimum": 1 },
          "before_hours": { "type": "number", "minimum": 1 },
          "type": {
            "type": "string",
            "enum": ["thaw", "fridge", "room_temp", "marinate", "soak", "custom"]
          }
        },
        "anyOf": [
          { "required": ["before_min"] },
          { "required": ["before_hours"] }
        ]
      }
    },
    "notes": {
      "type": "string"
    },
    "variations": {
      "type": "array",
      "description": "Вариации базового рецепта — чем отличается приготовление",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["title", "text"],
        "additionalProperties": false,
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "text": {
            "type": "string",
            "minLength": 1,
            "description": "Отличия от базового рецепта. Допускается ограниченный HTML: p, br, strong, b, em, i, ul, ol, li (без атрибутов)"
          }
        }
      }
    },
    "added": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "tried": {
      "type": "boolean",
      "description": "Рецепт уже готовил сам — показывается метка у названия"
    }
  }
}
