{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sol-chef.ru/schemas/tip.schema.json",
  "title": "Tips",
  "description": "Советы Энди Кукса в data/tips.json",
  "type": "object",
  "required": ["intro", "sections"],
  "additionalProperties": false,
  "properties": {
    "intro": {
      "type": "string",
      "minLength": 1
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "items"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^\\d{2}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
