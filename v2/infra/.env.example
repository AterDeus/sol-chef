# Local slice only. Copy to .env in this directory (v2/infra/.env).
# Compose reads v2/infra/.env for interpolation. Do not commit .env.
# Dummy values are not production secrets.

POSTGRES_USER=solchef
POSTGRES_PASSWORD=solchef-local
POSTGRES_DB=solchef

DJANGO_SECRET_KEY=django-insecure-local-dev-only-not-a-secret
DJANGO_DEBUG=1

# ETL reads V1 from the repo root mounted read-only at /v1-src.
V1_DATA_ROOT=/v1-src

# Next SSR talks to Django on the compose network. Browser uses same-origin /api via Caddy.
INTERNAL_API_URL=http://backend:8000
NEXT_PUBLIC_API_URL=
