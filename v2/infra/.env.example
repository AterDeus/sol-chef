# Copy to v2/infra/.env — never commit .env
# Local slice (docker-compose.yml) can keep the defaults below.
# Production (docker-compose.prod.yml) must replace every CHANGE_ME.

DJANGO_SECRET_KEY=CHANGE_ME_long_random_string
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=sol-chef.ru,www.sol-chef.ru,backend,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://sol-chef.ru,https://www.sol-chef.ru

POSTGRES_USER=solchef
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=solchef

DOMAIN=sol-chef.ru
ACME_EMAIL=CHANGE_ME@example.ru

# Hash from: docker run --rm caddy:2-alpine caddy hash-password --plaintext 'your-password'
# In this .env every `$` in the hash must be doubled (`$2a$` → `$$2a$$`), or Compose eats it.
ADMIN_BASIC_USER=solchef-admin
ADMIN_BASIC_HASH=CHANGE_ME

# First boot on a VPS IP: ./Caddyfile.http
# After DNS A-records point here: ./Caddyfile.prod
CADDYFILE=./Caddyfile.http

# Public origin for sitemap, canonical, Open Graph. After HTTPS: https://sol-chef.ru
SITE_URL=http://localhost:8080
