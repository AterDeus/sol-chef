# Browser → host :8080 → this container :80
# /api /admin /static /healthz → Django
# /_internal/*               → 404 (revalidate is Docker-network only)
# everything else            → Next.js (incl. HMR websocket)

:80 {
	encode gzip

	handle /_internal* {
		respond 404
	}

	handle /api* {
		reverse_proxy backend:8000
	}

	handle /admin* {
		reverse_proxy backend:8000
	}

	handle /static* {
		reverse_proxy backend:8000
	}

	handle /healthz* {
		reverse_proxy backend:8000
	}

	# Next.js webpack HMR. reverse_proxy upgrades WebSocket by default.
	handle /_next/webpack-hmr {
		reverse_proxy frontend:3000
	}

	handle {
		reverse_proxy frontend:3000
	}
}
