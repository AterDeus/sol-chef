  "steps": [
    {
      "position": 1,
      "text": "Нарезать лук, морковь и картофель. Чеснок порубить. Помидоры нарезать или отмерить томатное пюре."
    },
    {
      "position": 2,
      "text": "В кастрюле разогреть растительное масло. Пассеровать лук и морковь 5–7 минут, добавить чеснок на 30 секунд.",
      "timer_seconds": 420,
      "timer_label": "Пассерование овощей",
      "timer_note": "5–7 минут; чеснок — последние 30 секунд",
      "equipment_note": "Пассеровать в той же кастрюле, не перекладывать овощи на сковороду."
    },
    {
      "position": 3,
      "text": "Добавить картофель, помидоры или томатное пюре, лавровый лист и воду. Довести до кипения, посолить. Варить 15 минут.",
      "timer_seconds": 900,
      "timer_label": "Варка картофеля"
    },
    {
      "position": 4,
      "text": "Добавить фасоль. Прогреть 3–5 минут, пока картофель не станет мягким. Поперчить, снять лавровый лист, подать.",
      "timer_seconds": 300,
      "timer_label": "Прогрев фасоли",
      "timer_note": "3–5 минут; ориентир — мягкий картофель, не таймер"
    }
  ],
