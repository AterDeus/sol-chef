{
  "id": "makarony-s-myasnym-sousom",
  "title": "Макароны с мясным соусом",
  "summary": "Говяжий фарш тушат с луком, морковью и томатным пюре до густого соуса, затем смешивают с отваренной пастой. Фарш томят в томате полчаса, не жарят всухую с рожками.",
  "protein_base": "beef",
  "cook_method": "stew",
  "dish_type": "pasta_grains",
  "equipment": "pot",
  "energy_profile": "standard",
