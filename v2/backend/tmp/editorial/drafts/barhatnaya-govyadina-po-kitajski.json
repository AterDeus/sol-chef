{
  "id": "barhatnaya-govyadina-po-kitajski",
  "title": "Бархатная говядина по-китайски",
  "summary": "Недорогой отруб нарезают поперёк волокон, коротко выдерживают в смеси с небольшим количеством пищевой соды, обжаривают порциями и собирают в соево-чесночный соус. Крахмал, яичный белок и масло в маринаде держат сок внутри.",
  "protein_base": "beef",
  "cook_method": "pan_fry",
  "dish_type": "main",
  "equipment": "skillet",
  "energy_profile": "standard",
  "allowed_cuts": [
    "shoulder",
    "rump"
  ],
