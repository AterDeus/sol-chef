# Local slice only. Copy to v2/infra/.env — Compose loads env from that directory.
# Dummy values are not production secrets. Do not commit .env.

POSTGRES_USER=solchef
POSTGRES_PASSWORD=solchef-local
POSTGRES_DB=solchef

DJANGO_SECRET_KEY=django-insecure-local-dev-only-not-a-secret
DJANGO_DEBUG=1

# Next SSR talks to Django on the compose network. Browser uses same-origin /api via Caddy.
INTERNAL_API_URL=http://backend:8000
NEXT_PUBLIC_API_URL=

# Public origin for sitemap, canonical, Open Graph. After HTTPS: https://sol-chef.ru
SITE_URL=http://localhost:8080
