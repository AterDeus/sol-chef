  "notes": [
    {
      "title": "Нарезка",
      "text": "Только поперёк волокон и не толще 8 мм. Вдоль волокон соломка останется жёсткой, сколько ни жарь."
    },
    {
      "title": "Отруб",
      "text": "Огузок или вырезка. Стейк целиком — другое блюдо; печень строганов — другой slug."
    },
    {
      "title": "Сковорода",
      "text": "Партии в один слой на сильном огне. Полная сковорода даёт серый варёный сок, не корочку."
    },
    {
      "title": "Сметана",
      "text": "База — сметана 15–20%, не сливки. Вводить на слабом огне. Кипение даёт крупинки."
    },
    {
      "title": "Грибы",
      "text": "Только шампиньоны из магазина. Лесные, белые, «смесь сушёных» в этот addon не ставить."
    },
    {
      "title": "Полегче",
      "text": "Йогурт вместо сметаны и меньше масла. Тот же лук и та же нарезка, не куриный бульон вместо говядины."
    }
  ]
