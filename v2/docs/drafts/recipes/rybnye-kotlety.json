  "notes": [
    {
      "title": "Рыба",
      "text": "Минтай или хек — одна рыба на замес, не лосось. Кости вынуть: в фарше они не спрячутся."
    },
    {
      "title": "Влага",
      "text": "Размороженное филе отжать. Мокрый фарш не держит форму даже с картофелем и яйцом."
    },
    {
      "title": "Картофель",
      "text": "На 600 г рыбы — 200 г сырого. Больше — клейкие шарики; меньше — разваливаются. Хлеб в этот замес не класть."
    },
    {
      "title": "Сковорода",
      "text": "Партии в один слой на среднем огне. Полная сковорода — тушение: корочки нет, центр сырой или котлеты ломаются."
    },
    {
      "title": "Готовность",
      "text": "Белая рыба — 63 °C в центре. Дальше сухая крошка. Сырая серединка недопустима."
    },
    {
      "title": "Духовка",
      "text": "Противень и 190 °C, масла меньше. Время длиннее сковороды: 16–18 минут с переворотом."
    },
    {
      "title": "Пар",
      "text": "Форма или корзина, один слой, без корочки. Время около 15 минут — не жарка партиями."
    },
    {
      "title": "Тефтели",
      "text": "Тот же фарш, но шарики в томатно-сметанном соусе в кастрюле. Томление 16–18 минут — не котлеты, переложенные в кастрюлю без подливки."
    }
  ]
}
