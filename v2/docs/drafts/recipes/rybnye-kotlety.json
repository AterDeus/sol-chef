  "steps": [
    {
      "position": 1,
      "text": "Картофель очистить, отварить до мягкости, слить воду и размять в пюре без комочков. Остудить до тёплого.",
      "timer_seconds": 1200,
      "timer_label": "Картофель",
      "timer_note": "15–20 минут от закипания; пока варится — разделать рыбу и лук"
    },
    {
      "position": 2,
      "text": "Филе минтая или хека проверить на кости, прокрутить через мясорубку или очень мелко порубить."
    },
    {
      "position": 3,
      "text": "Лук нарезать очень мелко, укроп измельчить."
    },
    {
      "position": 4,
      "text": "Смешать рыбу, картофель, лук, яйцо, укроп и соль до однородности, не взбивая массу в пасту."
    },
    {
      "position": 5,
      "text": "Смочить руки и сформовать овальные котлеты толщиной около 1.5 см."
    },
    {
      "position": 6,
      "text": "Разогреть сковороду с маслом на среднем огне."
    },
    {
      "position": 7,
      "text": "Выложить котлеты небольшими партиями в один слой и жарить до золотистой корочки с обеих сторон и внутренней температуры 63 °C, один раз перевернуть.",
      "timer_seconds": 540,
      "timer_label": "Партия",
      "timer_note": "4–5 минут с первой стороны, 3–4 со второй; ориентир — 63 °C в центре, не таймер",
      "target_internal_temperature_c": 63,
      "equipment_note": "Не перегружать сковороду: жарить партиями в один слой, иначе котлеты тушатся в соку и разваливаются."
    }
  ],
