{
  "id": "bitye-ogurtsy-po-aziatski",
  "title": "«Битые» огурцы по-азиатски",
  "summary": "Пупырчатые огурцы плющат ножом или скалкой, заправляют соевым, чесноком и уксусом и оставляют на 10 минут. Не варить и не мариновать часами: хруст уходит, в миске остаётся рассол.",
  "protein_base": "vegetables",
  "cook_method": "no_cook",
  "dish_type": "salad",
