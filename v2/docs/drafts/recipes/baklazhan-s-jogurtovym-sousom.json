  "steps": [
    {
      "position": 1,
      "text": "Разогреть духовку до 200 °C."
    },
    {
      "position": 2,
      "text": "Нарезать баклажаны кругами толщиной 1.5 см. Кожуру не снимать."
    },
    {
      "position": 3,
      "text": "Посолить круги с двух сторон и оставить, чтобы вышла влага и ушла горечь.",
      "timer_seconds": 1200,
      "timer_label": "Соль",
      "timer_note": "15–20 минут; не пропускать — иначе круги водянистые и горчат"
    },
    {
      "position": 4,
      "text": "Промокнуть влагу и соль салфеткой. Смазать 40 мл масла со всех сторон и выложить на противень в один слой.",
      "equipment_note": "Один слой с зазорами. Нахлёст даст пар, не корочку."
    },
    {
      "position": 5,
      "text": "Запекать без крышки и без фольги до мягкой середины и румяных краёв: нож входит без сопротивления, круги держат форму.",
      "timer_seconds": 1500,
      "timer_label": "Запекание",
      "timer_note": "20–25 минут; ориентир — мягкость и цвет, не таймер"
    },
    {
      "position": 6,
      "text": "Пока запекается, смешать йогурт, давленый чеснок, зиру, сок лимона и мелко нарезанную мяту или петрушку. Соус в духовку не ставить — свернётся."
    },
    {
      "position": 7,
      "text": "Подавать круги сразу: соус отдельно или ложкой сверху на тарелке. Вместе не запекать."
    }
  ],
