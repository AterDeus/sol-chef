  "steps": [
    {
      "position": 1,
      "text": "Разогреть духовку до 200 °C."
    },
    {
      "position": 2,
      "text": "Очистить тыкву от кожуры и семян, нарезать кусками 2.5–3 см."
    },
    {
      "position": 3,
      "text": "Смешать на противне с 3 ст. л. масла, солью, перцем, раздавленным чесноком и травами."
    },
    {
      "position": 4,
      "text": "Распределить в один слой с зазорами. Горка в центре даст пар, не карамель.",
      "equipment_note": "Один слой на противне, без крышки и без фольги. Внахлёст тыква тушится в соку — получится каша, не запекание."
    },
    {
      "position": 5,
      "text": "Запекать без крышки, пока края не начнут золотиться.",
      "timer_seconds": 1200,
      "timer_label": "До перемешивания",
      "timer_note": "20 минут; середина ещё плотная — так и должно быть"
    },
    {
      "position": 6,
      "text": "Перемешать лопаткой и запекать до мягкой середины и карамельных краёв: нож входит без сопротивления, куски держат форму.",
      "timer_seconds": 1080,
      "timer_label": "До карамели",
      "timer_note": "Ещё 15–20 минут; ориентир — цвет и мягкость, не таймер"
    }
  ],
