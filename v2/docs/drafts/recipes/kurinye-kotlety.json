  "steps": [
    {
      "position": 1,
      "text": "Замочить хлеб в 200 мл холодной воды до мягкости.",
      "timer_seconds": 600,
      "timer_label": "Хлеб",
      "timer_note": "8–10 минут; хлеб должен размокнуть, не раскиснуть в кашу"
    },
    {
      "position": 2,
      "text": "Отжать хлеб насухо. Лук нарезать очень мелко, чеснок измельчить."
    },
    {
      "position": 3,
      "text": "Смешать фарш, отжатый хлеб, лук, яйцо, чеснок, соль, перец и по желанию укроп до однородности, не превращая массу в пасту."
    },
    {
      "position": 4,
      "text": "Отбить фарш: несколько раз собрать массу и с силой бросить в миску.",
      "timer_seconds": 60,
      "timer_label": "Отбивание",
      "timer_note": "1–2 минуты; масса должна стать липкой и держать форму"
    },
    {
      "position": 5,
      "text": "Смочить руки и сформовать овальные котлеты толщиной около 1.5 см, обвалять в муке."
    },
    {
      "position": 6,
      "text": "Разогреть сковороду с маслом на средне-сильном огне."
    },
    {
      "position": 7,
      "text": "Выложить котлеты небольшими партиями в один слой и жарить до румяной корочки с обеих сторон и внутренней температуры 74 °C, один раз перевернуть.",
      "timer_seconds": 600,
      "timer_label": "Партия",
      "timer_note": "5–6 минут с первой стороны, 4–5 со второй; ориентир — 74 °C в центре, не таймер",
      "target_internal_temperature_c": 74,
      "equipment_note": "Не перегружать сковороду: жарить партиями в один слой, иначе котлеты тушатся в соку и не доходят внутри."
    }
  ],
